{
	// 本配置文件仅配合模板部署使用，为模板部署的服务生成「服务设置」的初始值。
	// 服务已经建好的话，这里改了不生效，要到云托管控制台「服务设置」里改。
	// 会话存在云托管 MySQL，库和表由服务启动时自动创建。
	"containerPort": 80,
	"minNum": 0,
	"maxNum": 5,
	"cpu": 0.25,
	"mem": 0.5,
	"policyType": "cpu",
	"policyThreshold": 60,
	"envParams": {},
	"customLogs": "stdout",
	"dataBaseName": "xytx_mini"
}
